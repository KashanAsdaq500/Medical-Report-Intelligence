# Medical Report Intelligence - Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration:
# Local development default:
DATABASE_URL=sqlite:///./reports.db
# Production PostgreSQL (Render / Supabase / Railway):
# DATABASE_URL=postgresql://postgres_user:postgres_password@host:5432/medical_intelligence_db

# Model path (relative or absolute)
MODEL_PATH=models/diabetes_model.pkl

# CORS Origins (comma-separated or list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
